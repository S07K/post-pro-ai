# Local dev server port (optional, Next.js defaults to 3000)
PORT=3000

# --- MongoDB ---
# Connection string for your database. For local dev, run `mongod` and use the
# default below. For production, use a hosted cluster (e.g. MongoDB Atlas —
# atlas.mongodb.com — free tier is fine). Include the database name after the
# host (e.g. mongodb+srv://cluster0.xxxxx.mongodb.net/postproai), otherwise
# MongoDB silently uses an empty database called "test".
MONGO_URI=mongodb://localhost:27017/postproai
# Optional: database user credentials, kept out of MONGO_URI. When both are set
# they're passed to the driver separately, so the password does NOT need to be
# URL-encoded — paste it as-is. Leave both empty if MONGO_URI already contains
# credentials or your database has no auth (local dev).
MONGO_USER=
MONGO_PASSWORD=

# --- NextAuth (authentication) ---
# Random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
# Required in production; NextAuth will warn (but still run) without it in dev.
NEXTAUTH_SECRET=
# The canonical URL of this app. http://localhost:3000 for local dev; your
# production domain (e.g. https://your-app.vercel.app) when deployed.
NEXTAUTH_URL=http://localhost:3000

# --- OpenAI (DALL-E-3 image generation) ---
# Server-side only — never sent to the browser. Get a key at
# platform.openai.com/api-keys (requires a funded OpenAI account; image
# generation is billed per image).
OPENAI_API_KEY=

# --- Facebook / Instagram Graph API (posting to Instagram) ---
# All of these come from a Meta app you create at developers.facebook.com/apps
# (Facebook Login + Instagram Graph API products added to the app).
# Public app id, used by the Facebook JS SDK in the browser to open the login
# dialog. Safe to expose (NEXT_PUBLIC_*).
NEXT_PUBLIC_APP_ID=
# The "Configuration ID" of a Facebook Login for Business configuration on that
# app (App Dashboard > Facebook Login for Business > Configurations). Its
# permissions must be exactly the ones this app needs: instagram_basic,
# instagram_content_publish, pages_show_list, pages_read_engagement. Any
# invalid or deprecated permission in the configuration (e.g.
# instagram_manage_events) makes the login dialog fail with "Invalid Scopes".
NEXT_PUBLIC_CONFIG_ID=
# App ID and App Secret from the same Meta app's Settings > Basic page.
# FACEBOOK_APP_SECRET is server-side only, never exposed to the client.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Graph API base URL. Optional — defaults to the version in app/lib/utils.ts
# (FACEBOOK_GRAPH_VERSION). If you set it, keep the version in sync.
FACEBOOK_API_ENDPOINT=https://graph.facebook.com/v24.0

# --- Firebase Storage (hosts the generated post images) ---
# Create a project at console.firebase.google.com, enable Storage, then add a
# Web App (Project settings > General > Your apps) — these values come from
# that web app's config object.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Scheduled publishing ---
# Any random string you choose. The Vercel Cron job that publishes scheduled
# posts (see vercel.json) sends this as `Authorization: Bearer <value>` so
# only Vercel's cron can trigger /api/cron/publish-scheduled. Generate one the
# same way as NEXTAUTH_SECRET. Not required for local dev unless you want to
# test the cron route manually with curl.
CRON_SECRET=
