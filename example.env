PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/postproai

# NextAuth (run `openssl rand -base64 32` to generate a secret)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OpenAI (server-side only, never exposed to the client)
OPENAI_API_KEY=

# Facebook / Instagram Graph API
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_CONFIG_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_ENDPOINT=https://graph.facebook.com/v20.0

# Firebase Storage (generated post images)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Secret header required by the Vercel Cron job that publishes scheduled posts
CRON_SECRET=
